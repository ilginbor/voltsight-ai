!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/

# Temporary files
*.tmp
*.temp
# OSMnx download cache
cache/
